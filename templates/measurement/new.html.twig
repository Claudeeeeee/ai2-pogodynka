{% extends 'base.html.twig' %}

{% block title %}New Measurement{% endblock %}

{% block body %}
    <h1>Create New Measurement</h1>

    {# Start the form for creating a new measurement #}
    {{ form_start(form) }}

    {# Display each field with error messages #}
    {{ form_row(form.celsius) }}
    {% for error in form.celsius.vars.errors %}
        <div class="alert alert-danger">{{ error.message }}</div>
    {% endfor %}

    {# Include the weather record selection, assuming it's part of the form #}
    {{ form_row(form.weatherRecord) }}
    {% for error in form.weatherRecord.vars.errors %}
        <div class="alert alert-danger">{{ error.message }}</div>
    {% endfor %}

    <button type="submit">Create</button>
    {{ form_end(form) }}

    <a href="{{ path('app_measurement_index') }}">Back to list</a>
{% endblock %}
